  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 754881231}
  m_Text: "Using Single line mode, Replaces randomizer with manual Float value or
    by position random.\r\nthis  feature can be used for single lines.\r\nthis mode
    Also allows to use this shader with your custom wires, lines or cylindes can
    be used.\r\nyour mesh's vertrex colors still will be break look for some effects
    but disabling those masks in settings will allow \r\nshader to work with those
    meshes even if they not has those vertex colors or uv build ."
  m_OffsetZ: 0
  m_CharacterSize: 1
  m_LineSpacing: 1
